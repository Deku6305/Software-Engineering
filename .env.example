# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API Key (Server-side)
GEMINI_API_KEY=

# PostgreSQL Database (Docker)
POSTGRES_DB=linhung_pagoda
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
DATABASE_URL=postgres://admin:adminpassword@localhost:5432/linhung_pagoda

# Redis Cache (Optional for Docker)
REDIS_URL=redis://localhost:6379
